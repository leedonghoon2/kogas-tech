{
  // Cloudflare Workers (정적 자산) 배포 설정
  // 빌드 결과물(dist)을 그대로 서비스하며, SPA 라우팅을 위해 없는 경로는 index.html 로 응답합니다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hazmat-inventory",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
